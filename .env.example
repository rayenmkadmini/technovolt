# --- Email (optional) ---
# Configure if you want email notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# SMTP_FROM=noreply@technovolt.tn

# --- Analytics (optional) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- WhatsApp (optional) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=21626250027


# --- TechnoVolt Bot (AI Electrical Assistant) ---
# Configure one of the supported AI providers below.
# If unconfigured, the bot automatically runs on the built-in high-accuracy TechnoVolt Domain Knowledge Engine.
# GROQ_API_KEY=gsk_your_groq_api_key_here
# OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
# TECHNOVOLT_AI_MODEL=llama-3.3-70b-versatile
# TECHNOVOLT_AI_BASE_URL=https://api.openai.com/v1
# TECHNOVOLT_AI_API_KEY=your_custom_key_here
# --- OpenRouter (chatbot + auto-translate) ---
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here


# --- Cloudflare R2 Object Storage (Server-only secrets: NEVER prefix with NEXT_PUBLIC_) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=technovolt-media
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# Custom domain bound to R2 bucket (do NOT use r2.dev or S3 API endpoint in production)
R2_PUBLIC_URL=https://media.technovolt.tn

# --- Cloudflare Images Transformations (Public delivery configuration) ---
# Origin URL for public media assets (must match R2_PUBLIC_URL custom domain)
NEXT_PUBLIC_MEDIA_URL=https://media.technovolt.tn
# Backward-compatible alias (optional if NEXT_PUBLIC_MEDIA_URL is set):
NEXT_PUBLIC_MEDIA_PUBLIC_URL=https://media.technovolt.tn
# Set to "true" once Cloudflare Image Transformations (/cdn-cgi/image) is enabled on your zone
NEXT_PUBLIC_CLOUDFLARE_IMAGES_ENABLED=false
# Optional: custom transformation zone origin if different from NEXT_PUBLIC_MEDIA_PUBLIC_URL
# NEXT_PUBLIC_CLOUDFLARE_IMAGE_ZONE=https://media.technovolt.tn
